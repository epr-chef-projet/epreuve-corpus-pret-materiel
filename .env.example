# -----------------------------------------------------------------------------
# 01. Application
# -----------------------------------------------------------------------------
# Adresse et mode de fonctionnement.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://epr-c.localhost:8083
APP_PORT=8083

# Langues et données de démonstration.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance et hachage des mots de passe.
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
# APP_MAINTENANCE_STORE=database


# -----------------------------------------------------------------------------
# 02. Instance Docker
# -----------------------------------------------------------------------------
# Identité propre à ce clone, initialisée par scripts/bootstrap.
EPR_INSTANCE=c
COMPOSE_PROJECT_NAME=epr-c
EPR_ROOT_FINGERPRINT=
WWWUSER=1001
WWWGROUP=1001

# Sail/Compose et image du runtime de développement.
SAIL_FILES=compose.yaml
SAIL_DOCKER_BINARY=scripts/docker-guard
EPR_RUNTIME_IMAGE=
EPR_RUNTIME_SOURCE=


# -----------------------------------------------------------------------------
# 03. PostgreSQL
# -----------------------------------------------------------------------------
# Connexion interne utilisée par les services Docker.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=epr_app
DB_PASSWORD=
DB_SEARCH_PATH=epr

# Port publié sur le poste, pour PhpStorm notamment.
FORWARD_DB_PORT=54323

# Recherche des comptes avant identification de leur atelier.
AUTH_LOOKUP_PASSWORD=

# Initialisation SQL et chemins des secrets privés, hors du clone.
POSTGRES_BOOTSTRAP_USERNAME=epr_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD_FILE=
POSTGRES_APP_PASSWORD_FILE=
POSTGRES_MIGRATOR_PASSWORD_FILE=
POSTGRES_BACKUP_PASSWORD_FILE=
POSTGRES_AUTH_LOOKUP_PASSWORD_FILE=


# -----------------------------------------------------------------------------
# 04. Sessions
# -----------------------------------------------------------------------------
# Stockage Redis réservé aux sessions, durée et cookie.
SESSION_DRIVER=redis
SESSION_CONNECTION=sessions
SESSION_STORE=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=epr_c_session
SESSION_PATH=/
SESSION_DOMAIN=null


# -----------------------------------------------------------------------------
# 05. Redis et cache
# -----------------------------------------------------------------------------
# Connexion interne et bases réservées à chaque usage.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_PREFIX=epr_c_database_

# Cache applicatif.
CACHE_STORE=redis
# CACHE_PREFIX=

# Option alternative conservée ; Memcached ne fait pas partie des services Docker.
MEMCACHED_HOST=127.0.0.1


# -----------------------------------------------------------------------------
# 06. Traitements en arrière-plan
# -----------------------------------------------------------------------------
# File de travaux utilisée par les consommateurs.
QUEUE_CONNECTION=redis


# -----------------------------------------------------------------------------
# 07. Actualisations automatiques - Reverb
# -----------------------------------------------------------------------------
# Diffusion et identifiants du serveur.
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Adresse interne utilisée pour publier depuis Docker.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Adresse et port accessibles au navigateur sur le poste.
REVERB_PUBLIC_HOST=epr-c.localhost
REVERB_PUBLIC_PORT=8093
REVERB_PUBLIC_SCHEME=http


# -----------------------------------------------------------------------------
# 08. Courriels - Mailpit
# -----------------------------------------------------------------------------
# Connexion SMTP interne ; les messages restent dans Mailpit en développement.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Ports publiés sur le poste : SMTP puis interface de consultation.
FORWARD_MAILPIT_PORT=10253
FORWARD_MAILPIT_DASHBOARD_PORT=8027


# -----------------------------------------------------------------------------
# 09. Fichiers et stockage
# -----------------------------------------------------------------------------
# Disque utilisé par l'application.
FILESYSTEM_DISK=local

# Options S3/AWS disponibles si ce stockage est configuré.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# -----------------------------------------------------------------------------
# 10. Journaux
# -----------------------------------------------------------------------------
# Canaux et niveau de journalisation.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# -----------------------------------------------------------------------------
# 11. Outils de développement
# -----------------------------------------------------------------------------
# Vite : nom public de l'application et port du serveur de développement.
VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173

# Débogage PHP.
SAIL_XDEBUG_MODE=off

# Boost : les règles restent gérées dans .ai/rules.
BOOST_RULES_ENABLED=false

# Option PHP native, non utilisée par le serveur Sail.
# PHP_CLI_SERVER_WORKERS=4
