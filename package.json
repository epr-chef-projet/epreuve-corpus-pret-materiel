{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.12 <25",
        "npm": ">=11 <12"
    },
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "check": "npm run lint && npm run format:check",
        "check:fix": "npm run lint:fix && npm run format",
        "format": "prettier --write . '!.epr-local' '!project-management/local'",
        "format:check": "prettier --check . '!.epr-local' '!project-management/local'",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix --max-warnings=0",
        "types:check": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
        "check:format": "prettier --check . '!.epr-local' '!project-management/local'",
        "check:types": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
        "check:lint": "eslint . --max-warnings=0",
        "test:unit": "vitest run",
        "test:browser": "vite build --mode browser && playwright test --workers=1 --retries=0"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@lucide/vue": "^1.17.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-echo": "2.6.1",
        "laravel-vite-plugin": "^3.1.0",
        "pinia": "4.0.3",
        "pusher-js": "8.6.0",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13",
        "vue-i18n": "11.1.12",
        "vue-input-otp": "^0.3.2",
        "vue-sonner": "^2.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@intlify/devtools-types": "11.1.12",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "1.64.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^24.19.1",
        "@types/web-bluetooth": "0.0.21",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "2.5.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.7.0",
        "jsdom": "30.1.2",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.0.0",
        "vitest": "5.0.3",
        "vue-component-type-helpers": "3.3.12",
        "vue-tsc": "^3.3.12"
    },
    "packageManager": "npm@11.21.0"
}
