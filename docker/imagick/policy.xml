<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap>
<policymap>
    <policy domain="resource" name="memory" value="128MiB" />
    <policy domain="resource" name="map" value="128MiB" />
    <policy domain="resource" name="disk" value="256MiB" />
    <policy domain="resource" name="thread" value="1" />
    <policy domain="resource" name="time" value="55" />
    <policy domain="resource" name="width" value="4096" />
    <policy domain="resource" name="height" value="4096" />
    <policy domain="delegate" rights="none" pattern="*" />
    <policy domain="filter" rights="none" pattern="*" />
    <policy domain="path" rights="none" pattern="@*" />
    <policy domain="coder" rights="none" pattern="*" />
    <policy domain="coder" rights="read|write" pattern="{JPEG,PNG,WEBP}" />
</policymap>
