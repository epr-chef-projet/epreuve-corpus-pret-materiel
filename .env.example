APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://epr-c.localhost:8083

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Development identity; scripts/bootstrap initializes missing private settings only.
EPR_INSTANCE=c
COMPOSE_PROJECT_NAME=epr-c
WWWUSER=1001
WWWGROUP=1001
APP_PORT=8083
VITE_PORT=5173
FORWARD_DB_PORT=54323
FORWARD_MAILPIT_PORT=10253
FORWARD_MAILPIT_DASHBOARD_PORT=8027
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=epr_app
DB_PASSWORD=
DB_SEARCH_PATH=epr
SESSION_COOKIE=epr_c_session
SESSION_CONNECTION=sessions
SESSION_STORE=redis
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_PREFIX=epr_c_database_
SAIL_XDEBUG_MODE=off
POSTGRES_BOOTSTRAP_USERNAME=epr_bootstrap
# Paths to this instance’s private files outside the application root.
POSTGRES_BOOTSTRAP_PASSWORD_FILE=
POSTGRES_APP_PASSWORD_FILE=
POSTGRES_MIGRATOR_PASSWORD_FILE=
POSTGRES_BACKUP_PASSWORD_FILE=
POSTGRES_AUTH_LOOKUP_PASSWORD_FILE=
AUTH_LOOKUP_PASSWORD=

# Common starter: rules remain owned by .ai/rules.
BOOST_RULES_ENABLED=false
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=epr-c.localhost
REVERB_PUBLIC_PORT=8093
REVERB_PUBLIC_SCHEME=http

# Native Sail/Compose cycle with clone-specific preconditions.
SAIL_FILES=compose.yaml
SAIL_DOCKER_BINARY=scripts/docker-guard
EPR_ROOT_FINGERPRINT=
EPR_RUNTIME_IMAGE=
EPR_RUNTIME_SOURCE=
